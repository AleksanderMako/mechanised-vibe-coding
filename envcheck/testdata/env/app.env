# full line comment

   # indented comment
export EXPORTED=yes
PLAIN=hello
PADDED=   padded value   
SINGLE='single # not a comment'
SINGLE_NO_ESCAPES='keep\nliteral'
DOUBLE="line1\nline2 \"quoted\" back\\slash"
HASH_IN_QUOTES="a # b"
TRAILING=value # trailing comment
HASH_NO_SPACE=abc#def
EMPTY=
URL=postgres://user:pass@host/db?sslmode=disable
DUP=first
DUP=second
